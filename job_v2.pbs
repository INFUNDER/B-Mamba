#!/bin/bash
#PBS -l select=1:ncpus=4:mem=32GB:ngpus=1
#PBS -q gpu
#PBS -l walltime=12:00:00
# Recipe v2 run. Submit with:  qsub -v CFG=<full|baseline>,SEED=<int>[,FULL=1] job_v2.pbs
#   CFG=full      -> BC-SSM + deep supervision (B-Mamba)
#   CFG=baseline  -> exact S6 variant (no boundary conditioning), deep supervision kept
#   FULL=1        -> train on all 1450 images, save final EMA weights

cd $PBS_O_WORKDIR
source /home/soft/anaconda3/etc/profile.d/conda.sh
conda activate cod10
mkdir -p v2_logs results_json

case "$CFG" in
  full)     FLAGS="" ;;
  baseline) FLAGS="--no_boundary" ;;
  *) echo "Unknown CFG=$CFG"; exit 1 ;;
esac
EXTRA=""
RUN="v2_${CFG}_s${SEED}"
if [ "$FULL" = "1" ]; then EXTRA="--full_data"; RUN="v2full_${CFG}_s${SEED}"; fi

echo "[$(date)] Training $RUN ($FLAGS $EXTRA)"
python train_v2.py --run_name "$RUN" $FLAGS $EXTRA --strong_aug --epochs 100 --seed "$SEED" \
       > "v2_logs/train_${RUN}.log" 2>&1

echo "[$(date)] Evaluating $RUN (plain + flip-TTA)"
python eval_full_metrics.py --run_name "$RUN" $FLAGS > "v2_logs/eval_${RUN}.log" 2>&1
python eval_full_metrics.py --run_name "$RUN" $FLAGS --tta --tag _tta > "v2_logs/eval_${RUN}_tta.log" 2>&1
echo "[$(date)] Done $RUN"
