#!/bin/bash
#PBS -N resnet_mamba_cod
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=64g
#PBS -j oe
#PBS -V

# ============================================================
# PBS Job — ResNet + Mamba
# Submit:  qsub job_resnet_mamba.pbs
# Status:  qstat -ans
# Log:     cat resnet_mamba_cod.o<job_id>
# ============================================================

cd $PBS_O_WORKDIR
mkdir -p logs checkpoints/resnet_mamba

echo "=========================================="
echo "  Job     : ResNet + Mamba"
echo "  Job ID  : $PBS_JOBID"
echo "  Node    : $(hostname)"
echo "  Start   : $(date)"
echo "=========================================="

# ── Conda setup (exact as per HPC guide) ─────────────────────
source /home/soft/anaconda3/etc/profile.d/conda.sh
conda activate cod10         # ← apna env name yahan daalo

# ── CUDA load (exact as per HPC guide) ───────────────────────
module load cuda

# ── Paths ─────────────────────────────────────────────────────
SCRIPT_DIR="/home/ronit.28010/COD_Project/cod_comparison"
SHARED="$SCRIPT_DIR/shared"
DATA_ROOT="/home/ronit.28010/COD_Project/dataset/COD10K"   # ← apna data path daalo

# ── GPU check ────────────────────────────────────────────────
echo ""
echo "GPU info:"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
echo ""
echo "Python: $(which python3)"
echo "Training started: $(date)"
echo ""

# ── Run training ──────────────────────────────────────────────
PYTHONPATH="$SHARED:$SCRIPT_DIR/resnet_mamba" \
python3 "$SHARED/train.py" \
    --data_root   "$DATA_ROOT" \
    --save_dir    "$SCRIPT_DIR/checkpoints/resnet_mamba" \
    --model_name  resnet_mamba \
    --epochs      100 \
    --batch_size  16 \
    --img_size    384 \
    --lr          1e-4 \
    --num_workers 8 \
    --gpu         0 \
    --seed        42

EXIT_CODE=$?
echo ""
echo "=========================================="
echo "  Finished : $(date)"
echo "  Status   : $([ $EXIT_CODE -eq 0 ] && echo SUCCESS || echo FAILED)"
echo "  Checkpoint: checkpoints/resnet_mamba/best_model.pth"
echo "=========================================="
exit $EXIT_CODE
